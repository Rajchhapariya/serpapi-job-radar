*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.Python

# Virtual Environments
.venv/
venv/
env/
ENV/

# Databases, WAL Logs & Dumps
*.duckdb*
*.db
*.sqlite*
radar.duckdb*

# Testing & Coverage
tests/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Development Dependencies & Scratch Scripts
requirements-dev.txt
scratch*.py
test_live_*.py
scratch/
RULES.md

# Logs & Temporary Files
*.log
logs/
*.tmp

# Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
