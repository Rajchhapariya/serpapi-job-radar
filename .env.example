# SerpApi Secret Key (obtained from https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Server & Database Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
DUCKDB_PATH=radar.duckdb
DATABASE_PATH=radar.duckdb

# Caching & Quota Protection
CACHE_TTL_HOURS=24
SEARCH_BUDGET_PER_RUN=50
